  },
  "dependencies": {
    "@engram/core": "workspace:*",
    "@engram/pi-extension": "workspace:*",
    "@engram/server": "workspace:*"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "1.3.0"
  }
}
