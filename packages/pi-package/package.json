{
  "name": "@engram/pi-package",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Engram for pi: the governed memory tools, the engram skill and the /engram prompt template.",
  "keywords": [
    "pi-package"
  ],
  "pi": {
    "extensions": [
      "./src/extension.ts"
    ],
    "skills": [
      "./skills"
    ],
