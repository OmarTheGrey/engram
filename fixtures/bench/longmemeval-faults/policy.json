{
  "id": "longmemeval.lint-set",
  "version": 2,
  "write": [
    {
      "scope": "person",
      "allowed_sources": [
        "user",
        "document",
        "tool",
        "import",
        "model",
        "compaction"
      ],
      "confidence_floor": 0.3,
      "forbidden_classes": [],
      "requires_review": false
    },
    {
      "scope": "role",
      "allowed_sources": [
        "user",
        "document",
        "tool",
        "import"
      ],
      "confidence_floor": 0.5,
      "forbidden_classes": [
        "episodic"
      ],
      "requires_review": false
    },
    {
      "scope": "team",
      "allowed_sources": [
        "user",
        "document",
        "tool",
        "import"
      ],
      "confidence_floor": 0.6,
      "forbidden_classes": [
        "episodic"
      ],
      "requires_review": false
    },
    {
      "scope": "org",
      "allowed_sources": [
        "user",
        "document",
        "tool",
        "import"
      ],
      "confidence_floor": 0.8,
      "forbidden_classes": [
        "episodic"
      ],
      "requires_review": true
    }
  ],
  "read": {
    "matrix": [
      {
        "reader": "person",
        "may_read": [
          "person",
          "role",
          "team",
          "org"
        ]
      },
      {
        "reader": "role",
        "may_read": [
          "person",
          "role",
          "team",
          "org"
        ]
      },
      {
        "reader": "team",
        "may_read": [
          "role",
          "team",
          "org"
        ]
      },
      {
        "reader": "org",
        "may_read": [
          "team",
          "org"
        ]
      }
    ],
    "honour_grants": true
  },
  "retention": [
    {
      "scope": "person",
      "class": "episodic",
      "ttl": null,
      "budget": 5000,
      "eviction": "recency"
    },
    {
      "scope": "person",
      "class": "semantic",
      "ttl": null,
      "budget": 2000,
      "eviction": "utility"
    },
    {
      "scope": "person",
      "class": "procedural",
      "ttl": null,
      "budget": 200,
      "eviction": "utility"
    },
    {
      "scope": "role",
      "class": "semantic",
      "ttl": null,
      "budget": 2000,
      "eviction": "utility"
    },
    {
      "scope": "role",
      "class": "procedural",
      "ttl": null,
      "budget": 200,
      "eviction": "utility"
    },
    {
      "scope": "team",
      "class": "semantic",
      "ttl": null,
      "budget": 10000,
      "eviction": "utility"
    },
    {
      "scope": "team",
      "class": "procedural",
      "ttl": null,
      "budget": 500,
      "eviction": "utility"
    },
    {
      "scope": "org",
      "class": "semantic",
      "ttl": null,
      "budget": null,
      "eviction": "manual"
    },
    {
      "scope": "org",
      "class": "procedural",
      "ttl": null,
      "budget": null,
      "eviction": "manual"
    }
  ],
  "promotion": {
    "episodic_to_semantic": {
      "confirmations": 3,
      "or_review": true
    },
    "procedural": {
      "replay_k": 4,
      "replay_n": 5
    }
  },
  "lints": {
    "enabled": [
      "expired-validity",
      "source-changed",
      "scope-class-mismatch",
      "missing-provenance",
      "orphan",
      "duplicate",
      "contradiction",
      "unsupported-claim"
    ],
    "thresholds": {
      "near-duplicate": 0.85,
      "replay-drift.success-floor": 0.7,
      "replay-drift.min-trials": 10
    }
  },
  "schema_version": 1
}
