{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(make test)",
      "Bash(make lint)",
      "Bash(make lint-docs)",
      "Bash(make test-one *)",
      "Bash(pnpm --filter * test)",
      "Bash(uv run pytest *)"
