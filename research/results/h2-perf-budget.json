{
  "baseline_of": {
    "read": {
      "op": "sqlite-read",
      "why": "a read returns the ten items holding the word in the reader's scopes; the bare equivalent is one SELECT of those rows"
    },
    "write": {
      "op": "sqlite-write",
      "why": "an allowed write lands one item; the bare equivalent is one row inserted and committed on the same disk"
    },
    "write-deny": {
      "op": "sqlite-write",
      "why": "a denied write records exactly one row, its deny event, appended and committed in one transaction; the bare equivalent of recording one row durably is the same single-row insert, so the ratio is what the gate adds to the event's own write"
    }
  },
