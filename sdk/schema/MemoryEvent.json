{
  "title": "MemoryEvent",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "MemoryEvent.json",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-7[0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12})$"
    },
    "seq": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "ts": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
    },
    "op": {
      "type": "string",
      "enum": [
        "write",
        "read",
        "update",
        "evict",
        "promote",
        "retire",
        "lint",
        "gate",
        "bypass_blocked"
      ]
    },
    "item_id": {
      "anyOf": [
        {
          "type": "string",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-7[0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12})$"
        },
        {
          "type": "null"
        }
      ]
    },
    "actor": {
      "type": "string",
      "minLength": 1
    },
    "scope_from": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^(?:(?:person|role|team):[A-Za-z0-9._\\-/]+|org)$"
        },
        {
          "type": "null"
        }
      ]
    },
    "scope_to": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^(?:(?:person|role|team):[A-Za-z0-9._\\-/]+|org)$"
        },
        {
          "type": "null"
        }
      ]
    },
    "decision": {
      "type": "string",
      "enum": [
        "allow",
        "deny",
        "ask"
      ]
    },
    "reason": {
      "type": "string",
      "minLength": 1
    },
    "policy_id": {
      "type": "string",
      "minLength": 1
    },
    "item": {
      "anyOf": [
        {
          "$ref": "MemoryItem.json"
        },
        {
          "type": "null"
        }
      ]
    },
    "usage": {
      "type": "object",
      "properties": {
        "input_tokens": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "output_tokens": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "cost_usd": {
          "type": "number",
          "minimum": 0
        }
      },
      "required": [
        "input_tokens",
        "output_tokens",
        "cost_usd"
      ],
      "additionalProperties": false
    },
    "item_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "format": "uuid",
        "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-7[0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12})$"
      }
    },
    "schema_version": {
      "type": "number",
      "const": 1
    }
  },
  "required": [
    "id",
    "seq",
    "ts",
    "op",
    "item_id",
    "actor",
    "scope_from",
    "scope_to",
    "decision",
    "reason",
    "policy_id",
    "schema_version"
  ],
  "additionalProperties": false
}
