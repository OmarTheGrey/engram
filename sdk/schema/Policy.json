{
  "title": "Policy",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "Policy.json",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "write": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "scope": {
            "type": "string",
            "enum": [
              "person",
              "role",
              "team",
              "org"
            ]
          },
          "allowed_sources": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "user",
                "document",
                "tool",
                "model",
                "import",
                "compaction",
                "external"
              ]
            }
          },
          "confidence_floor": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "forbidden_classes": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "episodic",
                "semantic",
                "procedural"
              ]
            }
          },
          "requires_review": {
            "type": "boolean"
          }
        },
        "required": [
          "scope",
          "allowed_sources",
          "confidence_floor",
          "forbidden_classes",
          "requires_review"
        ],
        "additionalProperties": false
      }
    },
    "read": {
      "type": "object",
      "properties": {
        "matrix": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "reader": {
                "type": "string",
                "enum": [
                  "person",
                  "role",
                  "team",
                  "org"
                ]
              },
              "may_read": {
                "type": "array",
                "items": {
                  "type": "string",
                  "enum": [
                    "person",
                    "role",
                    "team",
                    "org"
                  ]
                }
              }
            },
            "required": [
              "reader",
              "may_read"
            ],
            "additionalProperties": false
          }
        },
        "honour_grants": {
          "type": "boolean"
        }
      },
      "required": [
        "matrix",
        "honour_grants"
      ],
      "additionalProperties": false
    },
    "retention": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "scope": {
            "type": "string",
            "enum": [
              "person",
              "role",
              "team",
              "org"
            ]
          },
          "class": {
            "type": "string",
            "enum": [
              "episodic",
              "semantic",
              "procedural"
            ]
          },
          "ttl": {
            "anyOf": [
              {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              },
              {
                "type": "null"
              }
            ]
          },
          "budget": {
            "anyOf": [
              {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              },
              {
                "type": "null"
              }
            ]
          },
          "eviction": {
            "type": "string",
            "enum": [
              "recency",
              "utility",
              "manual"
            ]
          }
        },
        "required": [
          "scope",
          "class",
          "ttl",
          "budget",
          "eviction"
        ],
        "additionalProperties": false
      }
    },
    "promotion": {
      "type": "object",
      "properties": {
        "episodic_to_semantic": {
          "type": "object",
          "properties": {
            "confirmations": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            },
            "or_review": {
              "type": "boolean"
            }
          },
          "required": [
            "confirmations",
            "or_review"
          ],
          "additionalProperties": false
        },
        "procedural": {
          "type": "object",
          "properties": {
            "replay_k": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            },
            "replay_n": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "replay_k",
            "replay_n"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "episodic_to_semantic",
        "procedural"
      ],
      "additionalProperties": false
    },
    "lints": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "thresholds": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "type": "number"
          }
        },
        "model": {
          "type": "object",
          "properties": {
            "evidence": {
              "type": "string",
              "enum": [
                "off",
                "on"
              ]
            }
          },
          "additionalProperties": false
        }
      },
      "required": [
        "enabled",
        "thresholds"
      ],
      "additionalProperties": false
    },
    "content_guards": {
      "type": "object",
      "properties": {
        "secrets": {
          "type": "string",
          "enum": [
            "off",
            "review",
            "block"
          ]
        },
        "pii": {
          "type": "string",
          "enum": [
            "off",
            "review",
            "block"
          ]
        },
        "injection_screen": {
          "type": "string",
          "enum": [
            "off",
            "default",
            "hardened"
          ]
        },
        "max_content_bytes": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        }
      },
      "additionalProperties": false
    },
    "trust": {
      "type": "object",
      "properties": {
        "unattested_floor": {
          "type": "string",
          "enum": [
            "off",
            "on"
          ]
        },
        "protect_trusted": {
          "type": "string",
          "enum": [
            "off",
            "on"
          ]
        }
      },
      "additionalProperties": false
    },
    "procedures": {
      "type": "object",
      "properties": {
        "safety_scan": {
          "type": "string",
          "enum": [
            "off",
            "report",
            "hold"
          ]
        },
        "drift": {
          "type": "object",
          "properties": {
            "environment_change": {
              "type": "string",
              "enum": [
                "off",
                "on"
              ]
            },
            "period": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "consent": {
      "type": "object",
      "properties": {
        "opt_outs": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "scope": {
                "type": "string",
                "pattern": "^person:[A-Za-z0-9._\\-/]+$"
              },
              "topic": {
                "type": "string",
                "minLength": 1
              },
              "source": {
                "type": "string",
                "enum": [
                  "user",
                  "document",
                  "tool",
                  "model",
                  "import",
                  "compaction",
                  "external"
                ]
              },
              "since": {
                "type": "string",
                "format": "date-time",
                "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
              },
              "until": {
                "type": "string",
                "format": "date-time",
                "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
              },
              "except_topics": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "required": [
              "scope"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "opt_outs"
      ],
      "additionalProperties": false
    },
    "erasure": {
      "type": "object",
      "properties": {
        "mode": {
          "type": "string",
          "enum": [
            "redact",
            "shred"
          ]
        }
      },
      "additionalProperties": false
    },
    "approval": {
      "type": "object",
      "properties": {
        "routes": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "scope": {
                "anyOf": [
                  {
                    "type": "string",
                    "enum": [
                      "person",
                      "role",
                      "team",
                      "org"
                    ]
                  },
                  {
                    "type": "string",
                    "pattern": "^(?:(?:person|role|team):[A-Za-z0-9._\\-/]+|org)$"
                  }
                ]
              },
              "approvers": {
                "minItems": 1,
                "type": "array",
                "items": {
                  "anyOf": [
                    {
                      "type": "string",
                      "const": "owner"
                    },
                    {
                      "type": "string",
                      "pattern": "^(?:role|person):[A-Za-z0-9._\\-/]+$"
                    }
                  ]
                }
              },
              "expires_after": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              }
            },
            "required": [
              "scope",
              "approvers"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "routes"
      ],
      "additionalProperties": false
    },
    "grants": {
      "type": "object",
      "properties": {
        "expiry_cap": {
          "type": "string",
          "enum": [
            "off",
            "on"
          ]
        }
      },
      "additionalProperties": false
    },
    "schema_version": {
      "type": "number",
      "const": 1
    }
  },
  "required": [
    "id",
    "version",
    "write",
    "read",
    "retention",
    "promotion",
    "lints",
    "schema_version"
  ],
  "additionalProperties": false
}
