{
  "title": "Policy",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "Policy.json",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "write": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "scope": {
            "type": "string",
            "enum": [
              "person",
              "role",
              "team",
              "org"
            ]
          },
          "allowed_sources": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "user",
                "document",
                "tool",
                "model",
                "import",
                "compaction",
                "external"
              ]
            }
          },
          "confidence_floor": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "forbidden_classes": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "episodic",
                "semantic",
                "procedural"
              ]
            }
          },
          "requires_review": {
            "type": "boolean"
          }
        },
        "required": [
          "scope",
          "allowed_sources",
          "confidence_floor",
          "forbidden_classes",
          "requires_review"
        ],
        "additionalProperties": false
      }
    },
    "read": {
      "type": "object",
      "properties": {
        "matrix": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "reader": {
                "type": "string",
                "enum": [
                  "person",
                  "role",
                  "team",
                  "org"
                ]
              },
              "may_read": {
                "type": "array",
                "items": {
                  "type": "string",
                  "enum": [
                    "person",
                    "role",
                    "team",
                    "org"
                  ]
                }
              }
            },
            "required": [
              "reader",
              "may_read"
            ],
            "additionalProperties": false
          }
        },
        "honour_grants": {
          "type": "boolean"
        }
      },
      "required": [
        "matrix",
        "honour_grants"
      ],
      "additionalProperties": false
    },
    "retention": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "scope": {
            "type": "string",
            "enum": [
              "person",
              "role",
              "team",
              "org"
            ]
          },
          "class": {
            "type": "string",
            "enum": [
              "episodic",
              "semantic",
              "procedural"
            ]
          },
          "ttl": {
            "anyOf": [
              {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              },
              {
                "type": "null"
              }
            ]
          },
          "budget": {
            "anyOf": [
              {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              },
              {
                "type": "null"
              }
            ]
          },
          "eviction": {
            "type": "string",
            "enum": [
              "recency",
              "utility",
              "manual"
            ]
          }
        },
        "required": [
          "scope",
          "class",
          "ttl",
          "budget",
          "eviction"
        ],
        "additionalProperties": false
      }
    },
    "promotion": {
      "type": "object",
      "properties": {
        "episodic_to_semantic": {
          "type": "object",
          "properties": {
            "confirmations": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            },
            "or_review": {
              "type": "boolean"
            }
          },
          "required": [
            "confirmations",
            "or_review"
          ],
          "additionalProperties": false
        },
        "procedural": {
          "type": "object",
          "properties": {
            "replay_k": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            },
            "replay_n": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "replay_k",
            "replay_n"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "episodic_to_semantic",
        "procedural"
      ],
      "additionalProperties": false
    },
    "lints": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "thresholds": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "type": "number"
          }
        }
      },
      "required": [
        "enabled",
        "thresholds"
      ],
      "additionalProperties": false
    },
    "schema_version": {
      "type": "number",
      "const": 1
    }
  },
  "required": [
    "id",
    "version",
    "write",
    "read",
    "retention",
    "promotion",
    "lints",
    "schema_version"
  ],
  "additionalProperties": false
}
