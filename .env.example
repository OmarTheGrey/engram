# Environment for working on Engram. Copy to .env (git-ignored), uncomment
# what you need, and load it into your shell (for example `set -a; . ./.env; set +a`).
# Nothing in the repository reads .env by itself, and no test needs any of this:
# CI runs offline (ENGRAM_OFFLINE=1) on scripted models and committed cassettes.
#
# `engram doctor` reports which of these are set, by name only; it never reads
# or prints a value. Dogfood content and keys never leave your machine (AGENTS.md rule 12).

# The event log. A SQLite file path, :memory:, or a postgres:// URL (ADR 0024;
# Postgres is opened through openPostgres, card E1.1). `--db` overrides it. Unset, the
# log is <home>/.engram/engram.db.
# ENGRAM_DB_URL=

# Refuse any model call that misses the cache (CI sets it).
# ENGRAM_OFFLINE=1

# Provider API keys, as pi-ai reads them (packages/runner/src/model/provider-keys.json,
# generated by `make api`). Set only the ones you use. Providers with ambient or
# OAuth credentials only (amazon-bedrock, openai-codex) have no key here.
# anthropic
# ANTHROPIC_API_KEY=
# ANTHROPIC_AUTH_TOKEN=
# ANTHROPIC_OAUTH_TOKEN=
# openai
# OPENAI_API_KEY=
# azure
# AZURE_OPENAI_API_KEY=
# google
# GEMINI_API_KEY=
# google-vertex
# GOOGLE_CLOUD_API_KEY=
# github-copilot
# COPILOT_GITHUB_TOKEN=
# openrouter
# OPENROUTER_API_KEY=
# vercel-ai-gateway
# AI_GATEWAY_API_KEY=
# mistral
# MISTRAL_API_KEY=
# deepseek
# DEEPSEEK_API_KEY=
# groq
# GROQ_API_KEY=
# cerebras
# CEREBRAS_API_KEY=
# xai
# XAI_API_KEY=
# together
# TOGETHER_API_KEY=
# fireworks
# FIREWORKS_API_KEY=
# huggingface
# HF_TOKEN=
# nvidia
# NVIDIA_API_KEY=
# baseten
# BASETEN_API_KEY=
# meta
# META_API_KEY=
# cloudflare-ai-gateway, cloudflare-workers-ai
# CLOUDFLARE_API_KEY=
# moonshotai, moonshotai-cn
# MOONSHOT_API_KEY=
# kimi-coding
# KIMI_API_KEY=
# minimax
# MINIMAX_API_KEY=
# minimax-cn
# MINIMAX_CN_API_KEY=
# zai
# ZAI_API_KEY=
# zai-coding-cn
# ZAI_CODING_CN_API_KEY=
# opencode, opencode-go
# OPENCODE_API_KEY=
# qwen-token-plan, qwen-token-plan-individual
# QWEN_TOKEN_PLAN_API_KEY=
# qwen-token-plan-cn
# QWEN_TOKEN_PLAN_CN_API_KEY=
# ant-ling
# ANT_LING_API_KEY=
# radius
# RADIUS_API_KEY=
# typesafe
# TYPESAFE_API_KEY=
# xiaomi
# XIAOMI_API_KEY=
